// ==========================================
// SUPER ADMIN CMS (Content Management System)
// ==========================================

model CmsAnnouncement {
  id             String    @id @default(uuid())
  title          String
  content        String    @db.Text
  type           String    @default("info") // info, warning, success, alert, maintenance
  priority       String    @default("normal") // low, normal, urgent
  targetPlan     String    @default("all") // all, free, starter, pro, enterprise
  targetAudience String    @default("all") // all, verified_only, unverified_only
  isActive       Boolean   @default(true)
  isDismissible  Boolean   @default(true)
  actionLabel    String?
  actionUrl      String?
  startDate      DateTime? @default(now())
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive])
}

model CmsArticle {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  category  String   @default("general") // general, whatsapp, automations, billing, api
  excerpt   String?  @db.Text
  content   String   @db.Text
  status    String   @default("published") // draft, published, archived
  author    String   @default("ChatNexGen Team")
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model CmsChangelog {
  id          String   @id @default(uuid())
  version     String
  title       String
  tag         String   @default("feature") // feature, improvement, fix, security
  content     String   @db.Text
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model CmsSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ==========================================
// HEALTHCARE: DEPARTMENTS, DOCTOR DETAILS, APPOINTMENT DETAILS
// (additive — migration 20261119000000_clinic_departments)
// ==========================================

model ClinicDepartment {
  id          String   @id @default(uuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors      DoctorDepartment[]
  appointments AppointmentDetail[]

  @@unique([clinicId, name])
  @@index([clinicId])
}

model DoctorDepartment {
  doctorId     String
  doctor       Doctor           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId String
  department   ClinicDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@id([doctorId, departmentId])
  @@index([departmentId])
}

/// Doctor contact & professional details (1:1 with Doctor).
model DoctorDetail {
  doctorId           String    @id
  doctor             Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  email              String?   @db.VarChar(191)
  phone              String?   @db.VarChar(32)
  registrationNumber String?   @db.VarChar(80)
  bio                String?   @db.Text
  designation        String?   @db.VarChar(80)
  /// Digital signature image; applied only to prescriptions the doctor finalizes.
  signature          Bytes?    @db.MediumBlob
  signatureMime      String?   @db.VarChar(40)
  signatureUpdatedBy String?
  signatureUpdatedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// Booking metadata (1:1 with Appointment): public appointment ID, patient
/// email/gender, chosen department and WhatsApp consent.
model AppointmentDetail {
  appointmentId   String            @id
  appointment     Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentRef  String            @unique @db.VarChar(32)
  departmentId    String?
  department      ClinicDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  patientEmail    String?           @db.VarChar(191)
  patientGender   String?           @db.VarChar(20)
  patientPhone    String?           @db.VarChar(32)
  whatsappConsent Boolean           @default(false)
  consentAt       DateTime?
  source          String            @default("dashboard") @db.VarChar(40)
  createdAt       DateTime          @default(now())

  @@index([departmentId])
}

/// One row per appointment message attempt. `eventKey` makes every send
/// idempotent (e.g. "r_1d@2026-11-20T10:00"), so ticks, retries and
/// reschedules can never double-message a patient.
model AppointmentNotificationLog {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointmentId   String
  appointment     Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  contactId       String?
  eventType       String           @db.VarChar(40)
  eventKey        String           @db.VarChar(120)
  channel         String           @default("none") @db.VarChar(20) // text | template | none
  templateId      String?
  template        MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateName    String?          @db.VarChar(120)
  templateVersion Int?
  phoneNumber     String?          @db.VarChar(32)
  messageId       String?          @db.VarChar(128)
  status          String           @default("pending") @db.VarChar(30) // pending | sent | failed | blocked_no_template | skipped_no_consent | skipped_window
  attempts        Int              @default(0)
  errorMessage    String?          @db.Text
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([appointmentId, eventKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([templateId])
}

// ── Smart consultation & medical records ──────────────────────────────

/// Medical profile for a patient (a clinic contact). One per contact.
model PatientProfile {
  id              String    @id @default(uuid())
  tenantId        String
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  contactId       String    @unique
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  patientCode     String    @db.VarChar(20) // e.g. P-000123, unique per tenant
  gender          String?   @db.VarChar(20)
  dateOfBirth     DateTime? @db.Date
  ageYears        Int?
  bloodGroup      String?   @db.VarChar(5)
  allergies       String?   @db.Text
  conditions      String?   @db.Text
  medications     String?   @db.Text
  surgicalHistory String?   @db.Text
  familyHistory   String?   @db.Text
  emergencyName   String?   @db.VarChar(120)
  emergencyPhone  String?   @db.VarChar(32)
  notes           String?   @db.Text
  phoneVerified   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, patientCode])
  @@index([tenantId])
  @@index([clinicId])
}

/// One consultation per appointment. Clinical sections are JSON so the
/// structure can grow without migrations; finalized prescriptions keep a
/// frozen snapshot for audit.
model Consultation {
  id             String      @id @default(uuid())
  tenantId       String
  clinicId       String
  clinic         Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentId  String      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         Doctor?     @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  status         String      @default("in_progress") @db.VarChar(20) // in_progress | completed | cancelled
  chiefComplaint Json?
  vitals         Json?
  history        Json?
  examination    String?     @db.Text
  diagnoses      Json?
  investigations Json?
  treatmentPlan  String?     @db.Text
  followUpDate   DateTime?   @db.Date
  revision       Int         @default(0) // autosave optimistic concurrency
  startedBy      String?
  completedBy    String?
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  durationSec    Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transcripts  ConsultationTranscript[]
  prescription Prescription?

  @@index([tenantId, status])
  @@index([contactId])
  @@index([doctorId])
}

/// Every voice/typed dictation, original text kept verbatim for audit.
/// Audio itself is never stored.
model ConsultationTranscript {
  id             String       @id @default(uuid())
  tenantId       String
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  source         String       @default("voice") @db.VarChar(20) // voice | typed
  originalText   String       @db.Text
  editedText     String?      @db.Text
  aiOutput       Json?
  model          String?      @db.VarChar(80)
  audioSeconds   Int?
  createdBy      String?
  createdAt      DateTime     @default(now())

  @@index([consultationId])
  @@index([tenantId])
}

model Prescription {
  id                String       @id @default(uuid())
  tenantId          String
  clinicId          String
  clinic            Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  consultationId    String       @unique
  consultation      Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  contactId         String
  contact           Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  doctorId          String?
  doctor            Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  prescriptionNo    String       @db.VarChar(32)
  status            String       @default("draft") @db.VarChar(20) // draft | finalized
  medicines         Json?
  advice            Json?
  snapshot          Json? // frozen header/doctor/patient/clinical data at finalization
  pdf               Bytes?       @db.MediumBlob
  pdfSha256         String?      @db.VarChar(64)
  verifyToken       String?      @db.VarChar(40)
  finalizedAt       DateTime?
  finalizedBy       String?
  deliveryStatus    String       @default("not_sent") @db.VarChar(20) // not_sent | pending | uploaded | sent | delivered | read | failed | blocked
  whatsappMessageId String?      @db.VarChar(128)
  mediaId           String?      @db.VarChar(128)
  deliveryError     String?      @db.Text
  deliveryAttempts  Int          @default(0)
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([tenantId, prescriptionNo])
  @@index([contactId])
  @@index([whatsappMessageId])
  @@index([tenantId, status])
}

/// One-time prescription branding per clinic.
model PrescriptionSettings {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  clinicId       String   @unique
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicName     String?  @db.VarChar(160)
  address        String?  @db.Text
  phone          String?  @db.VarChar(40)
  email          String?  @db.VarChar(191)
  website        String?  @db.VarChar(191)
  registrationNo String?  @db.VarChar(80)
  headerStyle    String   @default("classic") @db.VarChar(20)
  accentColor    String   @default("#0f766e") @db.VarChar(9)
  footerText     String?  @db.Text
  logo           Bytes?   @db.MediumBlob
  logoMime       String?  @db.VarChar(40)
  stamp          Bytes?   @db.MediumBlob
  stampMime      String?  @db.VarChar(40)
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MedicineCatalog {
  id           String   @id @default(uuid())
  tenantId     String
  name         String   @db.VarChar(160)
  genericName  String?  @db.VarChar(160)
  brandName    String?  @db.VarChar(160)
  strength     String?  @db.VarChar(60)
  form         String?  @db.VarChar(40)
  manufacturer String?  @db.VarChar(160)
  units        String?  @db.VarChar(60)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, name])
}

/// Reusable instruction/medicine sets a doctor can insert (never auto-applied).
model PrescriptionTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  doctorId  String?
  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(120)
  medicines Json?
  advice    Json?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model PatientDocument {
  id             String    @id @default(uuid())
  tenantId       String
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  consultationId String?
  kind           String    @default("other") @db.VarChar(30) // prescription | lab_report | scan | discharge | medical_report | other
  title          String    @db.VarChar(160)
  fileName       String    @db.VarChar(191)
  mimeType       String    @db.VarChar(80)
  size           Int
  data           Bytes     @db.MediumBlob
  uploadedBy     String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([tenantId, contactId])
}

// ==========================================
// GOOGLE REVIEW MODULE (additive, isolated)
// Every table carries tenantId and is registered as `direct` in
// src/server/kernel/tenant-scope.ts. Only ReviewBusiness has a Prisma
// relation to Tenant; the rest cascade through ReviewBusiness.
// ==========================================

model ReviewBusiness {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String    @db.VarChar(160)
  category        String?   @db.VarChar(120)
  description     String?   @db.Text
  address         String?   @db.VarChar(300)
  googleReviewUrl String?   @db.Text
  website         String?   @db.VarChar(300)
  phone           String?   @db.VarChar(40)
  logoUrl         String?   @db.MediumText
  services        Json?
  /// [{ platform, url }]: Instagram, Facebook, YouTube… shown on the QR landing page.
  socialLinks     Json?
  defaultLanguage String    @default("en") @db.VarChar(8)
  status          String    @default("active") @db.VarChar(20) // active | inactive
  publicToken     String    @unique @db.VarChar(40)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaigns  ReviewCampaign[]
  qrCodes    ReviewQRCode[]
  jobs       ReviewAutomationJob[]
  events     ReviewEngagementEvent[]
  aiRequests ReviewAIRequest[]
  approvals  ReviewCustomerApproval[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
}

model ReviewCampaign {
  id          String         @id @default(uuid())
  tenantId    String
  businessId  String
  business    ReviewBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String         @db.VarChar(160)
  description String?        @db.VarChar(500)
  status      String         @default("active") @db.VarChar(20) // active | paused
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  qrCodes   ReviewQRCode[]
  jobs      ReviewAutomationJob[]
  events    ReviewEngagementEvent[]
  approvals ReviewCustomerApproval[]

  @@index([tenantId, businessId])
}

model ReviewQRCode {
  id          String          @id @default(uuid())
  tenantId    String
  businessId  String
  business    ReviewBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    ReviewCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  label       String          @db.VarChar(160)
  placement   String?         @db.VarChar(60) // reception, billing, invoice, whatsapp, website...
  token       String          @unique @db.VarChar(40)
  fgColor     String          @default("#0f172a") @db.VarChar(9)
  bgColor     String          @default("#ffffff") @db.VarChar(9)
  includeLogo Boolean         @default(false)
  status      String          @default("active") @db.VarChar(20)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  jobs       ReviewAutomationJob[]
  events     ReviewEngagementEvent[]
  aiRequests ReviewAIRequest[]
  approvals  ReviewCustomerApproval[]

  @@index([tenantId, businessId])
  @@index([campaignId])
}

model ReviewCustomerApproval {
  id           String          @id @default(uuid())
  tenantId     String
  businessId   String
  business     ReviewBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     ReviewCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  qrCodeId     String?
  qrCode       ReviewQRCode?   @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  visitorId    String          @db.VarChar(64)
  rating       Int
  language     String          @db.VarChar(8)
  feedbackText String?         @db.Text
  finalText    String          @db.Text
  edited       Boolean         @default(false)
  consentAt    DateTime        @default(now())
  createdAt    DateTime        @default(now())

  jobs ReviewAutomationJob[]

  @@index([tenantId, businessId, createdAt])
}

model ReviewAutomationJob {
  id              String                  @id @default(uuid())
  tenantId        String
  businessId      String
  business        ReviewBusiness          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        ReviewCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  qrCodeId        String?
  qrCode          ReviewQRCode?           @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  approvalId      String?
  approval        ReviewCustomerApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  // pending | queued | initializing | browser_launched | navigating | preparing_review |
  // awaiting_customer_confirmation | completed | failed | cancelled
  status          String                  @default("pending") @db.VarChar(40)
  attempts        Int                     @default(0)
  maxAttempts     Int                     @default(3)
  lastError       String?                 @db.Text
  nextRunAt       DateTime                @default(now())
  lockedAt        DateTime?
  lockedBy        String?                 @db.VarChar(80)
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?
  screenshotPath  String?                 @db.VarChar(400)
  result          Json?
  cancelRequested Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  logs ReviewAutomationLog[]

  @@index([tenantId, status, createdAt])
  @@index([status, nextRunAt])
  @@index([businessId])
}

model ReviewAutomationLog {
  id        String              @id @default(uuid())
  tenantId  String
  jobId     String
  job       ReviewAutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String              @default("info") @db.VarChar(10) // info | warn | error
  message   String              @db.VarChar(500)
  meta      Json?
  createdAt DateTime            @default(now())

  @@index([jobId, createdAt])
  @@index([tenantId, createdAt])
}

model ReviewEngagementEvent {
  id         String          @id @default(uuid())
  tenantId   String
  businessId String
  business   ReviewBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   ReviewCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  qrCodeId   String?
  qrCode     ReviewQRCode?   @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  visitorId  String          @db.VarChar(64)
  // page_view | rating_selected | feedback_submitted | ai_generated | draft_approved |
  // review_copied | google_opened | customer_reported_done
  eventType  String          @db.VarChar(40)
  language   String?         @db.VarChar(8)
  rating     Int?
  /// Social platform for social_opened events (instagram, youtube…).
  platform   String?         @db.VarChar(30)
  createdAt  DateTime        @default(now())

  @@index([tenantId, businessId, createdAt])
  @@index([tenantId, eventType, createdAt])
  @@index([qrCodeId, eventType])
}

model ReviewAIRequest {
  id          String         @id @default(uuid())
  tenantId    String
  businessId  String
  business    ReviewBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  qrCodeId    String?
  qrCode      ReviewQRCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  kind        String         @db.VarChar(20) // generate | translate | shorten | expand
  language    String         @db.VarChar(8)
  rating      Int?
  inputChars  Int            @default(0)
  outputCount Int            @default(0)
  tokensUsed  Int            @default(0)
  success     Boolean        @default(true)
  error       String?        @db.VarChar(300)
  createdAt   DateTime       @default(now())

  @@index([tenantId, businessId, createdAt])
}

/// Sales-nurture state for one conversation: how many "are you still
/// interested?" nudges went out after the customer's last message. Resets
/// when the customer replies (`inboundAt` changes).
model LeadFollowUp {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId String    @unique
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// The customer message these nudges answer; a newer one restarts the cycle.
  inboundAt      DateTime
  step           Int       @default(0)
  status         String    @default("active") @db.VarChar(20) // active | exhausted | stopped
  stopReason     String?   @db.VarChar(60)
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([contactId])
}

/// A drip sequence: timed WhatsApp messages sent to enrolled contacts.
/// `steps` = [{ delayHours, kind: "template" | "text", templateName?, language?, params?, text? }];
/// delayHours counts from enrolment (step 1) or from the previous step.
model DripSequence {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(120)
  status      String   @default("active") @db.VarChar(20) // active | paused
  stopOnReply Boolean  @default(true)
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments DripEnrollment[]

  @@index([tenantId, status])
}

model DripEnrollment {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequenceId String
  sequence   DripSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  step       Int          @default(0) // index of the next step to send
  status     String       @default("active") @db.VarChar(20) // active | completed | stopped
  stopReason String?      @db.VarChar(60)
  nextRunAt  DateTime
  lastError  String?      @db.VarChar(500)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([sequenceId, contactId])
  @@index([status, nextRunAt])
  @@index([tenantId])
  @@index([contactId])
}

// ── Health & fitness: members and packages ──────────────────────────

/// A package a gym sells (e.g. "Monthly", "Quarterly + PT").
model GymPackage {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId   String
  business     BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String          @db.VarChar(120)
  description  String?         @db.Text
  durationDays Int
  price        Decimal         @db.Decimal(12, 2)
  /// Joining / admission fee charged once with the first membership.
  joiningFee   Decimal?        @db.Decimal(12, 2)
  features     Json?
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  GymMembership[]

  @@index([tenantId, isActive])
  @@index([businessId])
}

/// A gym member. Linked to the Contact so the Inbox and CRM see one person.
model GymMember {
  id                    String             @id @default(uuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessId            String
  business              BusinessProfile    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId             String
  contact               Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  memberCode            String             @db.VarChar(24)
  name                  String             @db.VarChar(120)
  phone                 String             @db.VarChar(32)
  email                 String?            @db.VarChar(191)
  gender                String?            @db.VarChar(20)
  dateOfBirth           DateTime?          @db.Date
  address               String?            @db.Text
  emergencyContactName  String?            @db.VarChar(120)
  emergencyContactPhone String?            @db.VarChar(32)
  heightCm              Int?
  weightKg              Decimal?           @db.Decimal(5, 1)
  fitnessGoal           String?            @db.VarChar(191)
  medicalNotes          String?            @db.Text
  notes                 String?            @db.Text
  joinedAt              DateTime           @db.Date
  status                String             @default("active") @db.VarChar(20) // active | frozen | inactive
  source                String             @default("manual") @db.VarChar(20) // manual | import | enquiry
  whatsappConsent       Boolean            @default(true)
  welcomeSentAt         DateTime?
  lastAttendanceAt      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  memberships           GymMembership[]
  messageLogs           MemberMessageLog[]

  @@unique([businessId, contactId])
  @@unique([businessId, memberCode])
  @@index([tenantId, status])
  @@index([tenantId, phone])
}

/// A package assigned to a member for a period.
model GymMembership {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId      String
  member        GymMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  packageId     String?
  package       GymPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  /// Snapshot, so renaming or deleting a package keeps history readable.
  packageName   String      @db.VarChar(120)
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  price         Decimal     @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal     @default(0) @db.Decimal(12, 2)
  paymentStatus String      @default("unpaid") @db.VarChar(20) // paid | partial | unpaid
  paymentMode   String?     @db.VarChar(30)
  status        String      @default("active") @db.VarChar(20) // active | cancelled
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, endDate])
  @@index([memberId])
  @@index([packageId])
}

/// One row per member message attempt; (memberId, eventKey) makes sends idempotent.
model MemberMessageLog {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberId        String
  member          GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contactId       String?
  eventType       String    @db.VarChar(40)
  eventKey        String    @db.VarChar(120)
  channel         String    @default("none") @db.VarChar(20)
  templateId      String?
  templateName    String?   @db.VarChar(120)
  templateVersion Int?
  phoneNumber     String?   @db.VarChar(32)
  messageId       String?   @db.VarChar(128)
  status          String    @default("pending") @db.VarChar(30)
  attempts        Int       @default(0)
  errorMessage    String?   @db.Text
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([memberId, eventKey])
  @@index([tenantId, createdAt])
}
